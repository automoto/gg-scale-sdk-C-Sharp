root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,csproj,props,sln}]
indent_size = 2

[Makefile]
indent_style = tab

[*.cs]
# Namespaces & usings
csharp_style_namespace_declarations = block_scoped:suggestion
dotnet_sort_system_directives_first = true

# var preferences: use var when the type is apparent
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-level preferences
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = false

# Nullability & modern APIs
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning

# Naming: private constants and static-readonly fields are PascalCase;
# other private fields _camelCase
dotnet_naming_rule.private_constants_pascal.symbols = private_constants
dotnet_naming_rule.private_constants_pascal.style = pascal_style
dotnet_naming_rule.private_constants_pascal.severity = warning
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
dotnet_naming_style.pascal_style.capitalization = pascal_case

dotnet_naming_rule.private_static_readonly_pascal.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly_pascal.style = pascal_style
dotnet_naming_rule.private_static_readonly_pascal.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Async library code must not capture the sync context
dotnet_diagnostic.CA2007.severity = error

# Multi-targeting netstandard2.1: ArgumentNullException.ThrowIfNull and
# friends (CA1510-CA1513) are net6+/net8+ APIs the core cannot use.
dotnet_diagnostic.CA1510.severity = none
dotnet_diagnostic.CA1511.severity = none
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1513.severity = none

# JsonKind.String/Object mirror the JSON spec's value kinds (same naming
# as System.Text.Json's JsonValueKind).
dotnet_diagnostic.CA1720.severity = none

# Organize usings
dotnet_diagnostic.IDE0005.severity = warning
